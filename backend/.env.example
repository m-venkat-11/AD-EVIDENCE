# AD-EVIDENCE Backend Configuration Template
# Copy this file to .env and insert your real API key

# Google Gemini API Key (Primary Provider)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Recommended Free Fallback Provider - Llama 3.3 70B)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Optional Free Tier Provider)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
